<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__PREFIX__.example-scraper</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__KIT__/with_global_slot.py</string>
        <string>--skip-if-busy</string>
        <string>example-scraper</string>
        <string>__PYTHON__</string>
        <string>__HOME__/automations/example_scraper.py</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>5</integer></dict>
        <dict><key>Minute</key><integer>35</integer></dict>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__LOGS__/example-scraper.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGS__/example-scraper.err.log</string>
</dict>
</plist>
